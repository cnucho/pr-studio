{
  "name": "pr-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3016",
    "build": "next build",
    "check:video": "node scripts/check-video-toolchain.mjs",
    "start": "node scripts/start-next.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "render:video": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render-final-video.ps1",
    "render:executive-demo:google": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render-with-google-tts.ps1 -ScriptPath docs/demo-scripts/research-executive-demo/render.mjs",
    "record:feedback-demo:google": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render-with-google-tts.ps1 -ScriptPath scripts/record-pr-studio-feedback-demo.mjs",
    "render:correction-demo": "node scripts/render-correction-level-agent-demo.mjs",
    "render:car-meta-hub-demo": "node scripts/render-car-meta-hub-review-demo.mjs",
    "render:auto-behavior-atlas-demo": "node scripts/render-auto-behavior-atlas-demo.mjs",
    "render:survey-quality-persona-demo": "node scripts/render-survey-quality-persona-pilot-demo.mjs",
    "render:office-ai-workflow-demo": "node scripts/render-office-ai-workflow-demo.mjs",
    "render:office-suite-full-demo": "node scripts/render-office-suite-full-demo.mjs",
    "render:mcp-live-usage:diagram": "node scripts/render-mcp-live-usage-demo.mjs --scenario docs/demo-scripts/live-usage-demos/fixtures/diagram-live-usage.json",
    "render:mcp-live-usage:aimm": "node scripts/render-mcp-live-usage-demo.mjs --scenario docs/demo-scripts/live-usage-demos/fixtures/aimm-live-usage.json",
    "render:mcp-live-usage:atlas": "node scripts/render-mcp-live-usage-demo.mjs --scenario docs/demo-scripts/live-usage-demos/fixtures/atlas-live-usage.json",
    "record:mcp-live-usage:gwriter": "node scripts/record-gwriter-mcp-handoff.mjs",
    "compose:mcp-live-usage:gwriter": "node scripts/compose-gwriter-mcp-live-usage.mjs --scenario docs/demo-scripts/live-usage-demos/fixtures/gwriter-live-usage-v2.json --editor-video out/live-usage-demos/gwriter-mcp-live-usage/gwriter-mcp-live-usage-ko.mp4",
    "render:questionnaire-recovery-demo": "node scripts/render-questionnaire-recovery-demo.mjs",
    "render:youtube-ethnography-demo": "node scripts/render-youtube-ethnography-studio-demo.mjs",
    "render:academy:premium": "node scripts/render-premium-academy-demo.mjs",
    "worker:video": "tsx scripts/video-agent-worker.ts",
    "worker:video:once": "tsx scripts/video-agent-worker.ts --once",
    "capture:video:v2": "node scripts/capture-video-v2.mjs",
    "render:video:v2": "node scripts/render-video-v2.mjs",
    "render:text-analysis-copilot-demo": "node scripts/render-text-analysis-copilot-demo.mjs",
    "review:video:v2": "node scripts/review-video-v2.mjs",
    "smoke:video:collection": "tsx scripts/smoke-video-collection.ts",
    "smoke:video:production": "tsx scripts/smoke-video-production.ts",
    "smoke:video:analysis": "tsx scripts/smoke-video-analysis.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "framer-motion": "^12.18.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.61.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.31",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.29.0",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.31",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.31",
    "sharp": "0.35.5"
  }
}
